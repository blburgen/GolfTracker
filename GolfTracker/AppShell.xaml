<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GolfTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:GolfTracker.Pages"
    Title="GolfTracker"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate pages:WelcomePage}"
        Route="WelcomePage" />

    <ShellContent
        Title="Sign In"
        ContentTemplate="{DataTemplate pages:SignIn}"
        Route="SignIn" />

    <ShellContent
        Title="New Game"
        ContentTemplate="{DataTemplate pages:NewGame}"
        Route="NewGame" />

    <ShellContent
        Title="Scorecard"
        ContentTemplate="{DataTemplate pages:Scorecard}"
        Route="Scorecard" />

    <ShellContent
        Title="History"
        ContentTemplate="{DataTemplate pages:History}"
        Route="History" />

</Shell>
