<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:GolfTracker.Controls"
    x:Class="GolfTracker.Pages.History"
    Title="History"
    BackgroundColor="{StaticResource BackgroundWhite}">

    <Grid RowDefinitions="Auto,*">

        <!-- Shared navigation header -->
        <controls:NavigationHeader
            Grid.Row="0" />

        <!-- History page content -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24"
                Spacing="20"
                VerticalOptions="Center">

                <Label
                    Text="History Tab Placeholder"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource PrimaryGreen}"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
